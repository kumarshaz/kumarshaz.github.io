---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type BlogData = CollectionEntry<'blog'>['data'];

interface Props extends Partial<BlogData> {
	title: string;
	description: string;
	pubDate: Date;
	headings?: MarkdownHeading[];
	slug?: string;
	category?: string;
	status?: string;
	repoUrl?: string;
	liveUrl?: string;
	backHref?: string;
	backLabel?: string;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category = 'Essay',
	tags = [],
	readingTime,
	headings = [],
	repoUrl,
	liveUrl,
	backHref = '/blog',
	backLabel = '← All Articles',
} = Astro.props;

const tocHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			.spec-article {
				width: 100%;
			}

			/* Article Header Masthead (Option D: Bold 2px Bottom Rule) */
			.article-masthead {
				padding: 2.75rem 0 2rem 0;
				border-bottom: 2px solid var(--border-strong);
			}

			.article-meta-bar {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-bottom: 1rem;
				font-family: var(--font-mono);
				font-size: 0.76rem;
				color: var(--text-muted);
			}

			.spec-title {
				font-family: var(--font-display);
				font-size: clamp(1.95rem, 3.5vw, 2.85rem);
				font-weight: 700;
				line-height: 1.15;
				letter-spacing: -0.025em;
				color: var(--text-primary);
				margin: 0 0 1rem 0;
				max-width: 28ch;
			}

			.spec-abstract {
				font-family: var(--font-sans);
				font-size: 1.08rem;
				line-height: 1.62;
				color: var(--text-muted);
				margin: 0;
				max-width: 68ch;
			}

			.spec-hero-figure {
				margin: 0 0 2.25rem 0;
				border: 1px solid var(--border-grid);
				background-color: var(--bg-surface);
				padding: 0.45rem;
			}

			.spec-hero-figure img {
				display: block;
				width: 100%;
				height: auto;
				border: 1px solid var(--border-grid);
				margin: 0;
				padding: 0;
			}

			.last-updated-on {
				margin-top: 0.35rem;
				font-size: 0.74rem;
				color: var(--text-muted);
			}

			.back-to-index {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--text-muted);
				text-decoration: none;
				padding-top: 1.25rem;
				border-top: 1px solid var(--border-grid);
				margin-top: 1.5rem;
				transition: color 0.15s ease;
			}

			.back-to-index:hover {
				color: var(--accent-primary);
				text-decoration: underline;
				text-underline-offset: 0.22em;
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main-content">
			<article
				class="spec-article"
				data-category={category}
				data-mermaid-engine="v12-elk-tidytree"
				data-mermaid-tokens="--mermaid-node-bg --mermaid-node-border"
			>
				<!-- Top Article Masthead -->
				<header class="notebook-container">
					<div class="article-masthead">
						<div class="article-meta-bar">
							<span class="mono-badge">[{category}]</span>
							<span>
								<FormattedDate date={pubDate} />
							</span>
							{readingTime && <span>· {readingTime}</span>}
						</div>
						<h1 class="spec-title">{title}</h1>
						<p class="spec-abstract">{description}</p>
					</div>
				</header>

				<!-- Open 2-Column Reading Workspace -->
				<div class="architect-grid">
					<aside class="architect-rail" aria-label="Article Metadata and Table of Contents">
						<div class="rail-sticky">
							<div class="rail-block">
								<span class="rail-label">Published</span>
								<span class="rail-value">
									<FormattedDate date={pubDate} />
								</span>
								{
									updatedDate && (
										<div class="last-updated-on">
											Updated <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>

							<div class="rail-block">
								<span class="rail-label">Category</span>
								<span class="rail-value">{category}</span>
							</div>

							{
								(liveUrl || repoUrl) && (
									<div class="rail-block">
										<span class="rail-label">
											{liveUrl && repoUrl
												? 'Product & Source'
												: liveUrl
													? 'Product UI'
													: 'Repository'}
										</span>
										<div class="rail-action-links">
											{liveUrl && (
												<a
													href={liveUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="action-pill live-pill"
												>
													Product UI ↗
												</a>
											)}
											{repoUrl && (
												<a
													href={repoUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="action-pill repo-pill"
												>
													GitHub Repo ↗
												</a>
											)}
										</div>
									</div>
								)
							}

							<div class="rail-block" id="rail-toc-block">
								<span class="rail-label">ON THIS PAGE</span>
								<ul class="rail-toc-list" id="rail-toc-list">
									{
										tocHeadings.map((heading) => (
											<li class={`toc-depth-${heading.depth}`}>
												<a href={`#${heading.slug}`}>{heading.text}</a>
											</li>
										))
									}
								</ul>
							</div>

							{
								tags && tags.length > 0 && (
									<div class="rail-block">
										<span class="rail-label">TAGS</span>
										<ul class="rail-tags">
											{tags.map((tag) => (
												<li>
													<a href={`/blog/tag/${tag.toLowerCase()}/`} class="rail-tag">
														#{tag}
													</a>
												</li>
											))}
										</ul>
									</div>
								)
							}

							<a href={backHref} class="back-to-index">{backLabel}</a>
						</div>
					</aside>

					<div class="architect-main prose" id="article-prose">
						{
							heroImage && (
								<figure class="spec-hero-figure">
									<Image width={1200} src={heroImage} alt={title} />
								</figure>
							)
						}
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />

		<script is:inline>
			// Populate ON THIS PAGE Table of Contents for pages without pre-extracted Markdown headings (e.g., /about)
			document.addEventListener('DOMContentLoaded', () => {
				const tocList = document.getElementById('rail-toc-list');
				const prose = document.getElementById('article-prose');
				if (tocList && prose && tocList.children.length === 0) {
					const headings = prose.querySelectorAll('h1, h2, h3');
					headings.forEach((h, idx) => {
						if (!h.id) {
							h.id =
								h.textContent
									.toLowerCase()
									.replace(/[^a-z0-9]+/g, '-')
									.replace(/(^-|-$)/g, '') || `section-${idx + 1}`;
						}
						const li = document.createElement('li');
						li.className = `toc-depth-${h.tagName === 'H3' ? '3' : '2'}`;
						const a = document.createElement('a');
						a.href = `#${h.id}`;
						a.textContent = h.textContent;
						li.appendChild(a);
						tocList.appendChild(li);
					});
				}
			});
		</script>

		<script>
			import mermaid from 'mermaid';
			import elkLayouts from '@mermaid-js/layout-elk';
			import tidyTreeLayouts from '@mermaid-js/layout-tidy-tree';

			interface LayoutNodeLike {
				id: string;
				domId?: string;
				parentId?: string;
				isGroup?: boolean;
				shape?: string;
				width?: number;
				height?: number;
				padding?: number;
				labelPaddingX?: number;
				look?: string;
				layoutOptions?: Record<string, unknown>;
			}

			interface LayoutEdgeLike {
				id?: string;
				start?: string;
				end?: string;
				[key: string]: unknown;
			}

			type EdgesArrayLike = LayoutEdgeLike[] & {
				defaultInterpolate?: unknown;
				defaultStyle?: unknown;
				[key: string]: unknown;
			};

			interface LayoutDataLike {
				nodes: LayoutNodeLike[];
				edges: EdgesArrayLike;
				[key: string]: unknown;
			}

			type ElkRenderFn = (
				data4Layout: LayoutDataLike,
				svg: {
					node?: () => SVGSVGElement | null;
					select: (selector: string) => { selectAll: (s: string) => { remove: () => void } };
				},
				helpers: unknown,
				options: unknown,
			) => Promise<void>;

			const cloneEdgesArray = (edges: EdgesArrayLike): EdgesArrayLike => {
				const cloned: EdgesArrayLike = Array.isArray(edges)
					? edges.map((edge) => ({ ...edge }))
					: [];
				if (edges && typeof edges === 'object') {
					for (const key of Object.keys(edges)) {
						if (!/^\d+$/.test(key)) {
							cloned[key] = edges[key];
						}
					}
				}
				return cloned;
			};

			const cloneLayoutData = (src: LayoutDataLike): LayoutDataLike => ({
				...src,
				nodes: Array.isArray(src.nodes)
					? src.nodes.map((node) => ({
							...node,
							...(node.layoutOptions ? { layoutOptions: { ...node.layoutOptions } } : {}),
						}))
					: [],
				edges: cloneEdgesArray(src.edges),
			});

			const cylinderRyOf = (width: number): number =>
				width > 0 ? width / 2 / (2.5 + width / 50) : 0;

			const isDiamondShape = (shape?: string): boolean =>
				shape === 'question' ||
				shape === 'diamond' ||
				shape === 'decision' ||
				shape === 'diam';

			const isCylinderShape = (shape?: string): boolean =>
				shape === 'cylinder' || shape === 'linedCylinder';

			const isSquareRectShape = (shape?: string): boolean =>
				shape === 'squareRect' || shape === 'rect' || shape === 'datastore';

			const measureRenderedLabelBoxes = (
				svg: { node?: () => SVGSVGElement | null },
			): Map<string, { w: number; h: number }> => {
				const boxes = new Map<string, { w: number; h: number }>();
				const svgRoot = typeof svg.node === 'function' ? svg.node() : null;
				if (!svgRoot) return boxes;
				const nodeGroups = svgRoot.querySelectorAll<SVGGElement>('g.node');
				for (const ng of nodeGroups) {
					if (!ng.id) continue;
					const fo = ng.querySelector<SVGForeignObjectElement>('foreignObject');
					if (fo) {
						const w = parseFloat(fo.getAttribute('width') || '0');
						const h = parseFloat(fo.getAttribute('height') || '0');
						if (w > 0 || h > 0) {
							boxes.set(ng.id, { w, h });
							continue;
						}
					}
					const labelEl = ng.querySelector<SVGGraphicsElement>('g.label text, g.label');
					if (labelEl) {
						try {
							const bb = labelEl.getBBox();
							if (bb.width > 0 || bb.height > 0) {
								boxes.set(ng.id, { w: bb.width, h: bb.height });
							}
						} catch {
							// Ignore unrendered SVG nodes
						}
					}
				}
				return boxes;
			};

			interface NodeUniformOverride {
				width?: number;
				height?: number;
				padding?: number;
				labelPaddingX?: number;
			}

			const createUniformSubgraphRender = (originalRender: ElkRenderFn): ElkRenderFn => {
				return async (data4Layout, svg, helpers, options) => {
					const groupChildren = new Map<string, string[]>();
					for (const node of data4Layout.nodes) {
						if (node.isGroup) {
							groupChildren.set(node.id, []);
						}
					}
					for (const node of data4Layout.nodes) {
						if (!node.isGroup && node.parentId && groupChildren.has(node.parentId)) {
							groupChildren.get(node.parentId)!.push(node.id);
						}
					}

					const multiChildGroups = [...groupChildren.entries()].filter(
						([, childIds]) => childIds.length >= 2,
					);

					if (multiChildGroups.length === 0) {
						await originalRender(data4Layout, svg, helpers, options);
						return;
					}

					const origSnapshot = cloneLayoutData(data4Layout);
					const probeData = cloneLayoutData(origSnapshot);

					// Pass 1: measure natural rendered dimensions & wrapped label boxes without node.width overrides
					await originalRender(probeData, svg, helpers, options);
					const probeLabelBoxes = measureRenderedLabelBoxes(svg);
					svg.select('g').selectAll('*').remove();

					const probeById = new Map(probeData.nodes.map((n) => [n.id, n]));
					const origById = new Map(origSnapshot.nodes.map((n) => [n.id, n]));

					const lookupLabelBox = (
						labelBoxes: Map<string, { w: number; h: number }>,
						node: LayoutNodeLike,
					) => (node.domId ? labelBoxes.get(node.domId) : undefined) ?? labelBoxes.get(node.id);

					const computeOverrides = (
						measuredById: Map<string, LayoutNodeLike>,
						labelBoxes: Map<string, { w: number; h: number }>,
						prevOverrides?: Map<string, NodeUniformOverride>,
					): Map<string, NodeUniformOverride> => {
						const next = new Map<string, NodeUniformOverride>();

						for (const [, childIds] of multiChildGroups) {
							const measured = childIds
								.map((id) => measuredById.get(id))
								.filter((n): n is LayoutNodeLike => Boolean(n));

							const diamonds = measured.filter((n) => isDiamondShape(n.shape));
							const rectLike = measured.filter((n) => !isDiamondShape(n.shape));

							if (diamonds.length >= 2) {
								const maxSide = Math.max(...diamonds.map((n) => n.width || 0));
								for (const d of diamonds) {
									const curSide = d.width || 0;
									const lb = lookupLabelBox(labelBoxes, d);
									const prevPad = prevOverrides?.get(d.id)?.padding;
									if (lb && (lb.w > 0 || lb.h > 0)) {
										if (maxSide > curSide + 0.5 || prevPad !== undefined) {
											next.set(d.id, { padding: Math.max(0, (maxSide - lb.w - lb.h) / 2) });
										}
									} else if (maxSide > curSide + 0.5) {
										const origNode = origById.get(d.id);
										const basePad =
											prevPad !== undefined
												? prevPad
												: typeof origNode?.padding === 'number' &&
													  Number.isFinite(origNode.padding)
													? origNode.padding
													: 15;
										next.set(d.id, { padding: basePad + (maxSide - curSide) / 2 });
									} else if (prevPad !== undefined) {
										next.set(d.id, { padding: prevPad });
									}
								}
							}

							if (rectLike.length >= 2) {
								const maxW = Math.max(...rectLike.map((n) => n.width || 0));
								let maxH = Math.max(...rectLike.map((n) => n.height || 0));

								for (const r of rectLike) {
									const lb = lookupLabelBox(labelBoxes, r);
									if (isCylinderShape(r.shape)) {
										const natW = r.width || 0;
										const natH = r.height || 0;
										const deltaRy = Math.max(0, cylinderRyOf(maxW) - cylinderRyOf(natW));
										if (deltaRy > 0) {
											maxH = Math.max(maxH, Math.ceil(natH + 3 * deltaRy));
										}
									} else if (r.shape === 'roundedRect' && lb && lb.w > 0) {
										const padXNeeded = Math.max(0, (maxW - lb.w) / 2);
										maxH = Math.max(maxH, Math.ceil(lb.h + 2 * padXNeeded));
									}
								}

								for (const r of rectLike) {
									const lb = lookupLabelBox(labelBoxes, r);
									if (isSquareRectShape(r.shape) && lb && lb.w > 0) {
										next.set(r.id, {
											labelPaddingX: Math.max(0, (maxW - lb.w) / 2),
											height: maxH,
										});
									} else if (r.shape === 'roundedRect' && lb && lb.w > 0) {
										next.set(r.id, {
											padding: Math.max(0, (maxW - lb.w) / 2),
											height: maxH,
										});
									} else {
										next.set(r.id, { width: maxW, height: maxH });
									}
								}
							}
						}

						return next;
					};

					const applyOverrides = (
						targetNodes: LayoutNodeLike[],
						overrides: Map<string, NodeUniformOverride>,
					) => {
						for (const node of targetNodes) {
							const ov = overrides.get(node.id);
							if (!ov) continue;
							if (ov.width !== undefined) node.width = ov.width;
							if (ov.height !== undefined) node.height = ov.height;
							if (ov.padding !== undefined) node.padding = ov.padding;
							if (ov.labelPaddingX !== undefined) node.labelPaddingX = ov.labelPaddingX;
						}
					};

					let currentOverrides = computeOverrides(probeById, probeLabelBoxes);
					applyOverrides(data4Layout.nodes, currentOverrides);

					// Pass 2: full ELK layout + paint with uniform per-subgraph dimensions
					await originalRender(data4Layout, svg, helpers, options);

					// Safety convergence passes for any shape that ignores labelPaddingX (e.g. subroutine/stadium)
					for (let pass = 0; pass < 2; pass++) {
						const passById = new Map(data4Layout.nodes.map((n) => [n.id, n]));
						let diverged = false;
						for (const [, childIds] of multiChildGroups) {
							const passRects = childIds
								.map((id) => passById.get(id))
								.filter((n): n is LayoutNodeLike => Boolean(n && !isDiamondShape(n.shape)));
							if (passRects.length >= 2) {
								const ws = passRects.map((n) => n.width || 0);
								const hs = passRects.map((n) => n.height || 0);
								if (
									Math.max(...ws) - Math.min(...ws) > 1.5 ||
									Math.max(...hs) - Math.min(...hs) > 1.5
								) {
									diverged = true;
									break;
								}
							}
							const passDiamonds = childIds
								.map((id) => passById.get(id))
								.filter((n): n is LayoutNodeLike => Boolean(n && isDiamondShape(n.shape)));
							if (passDiamonds.length >= 2) {
								const ws = passDiamonds.map((n) => n.width || 0);
								if (Math.max(...ws) - Math.min(...ws) > 1.5) {
									diverged = true;
									break;
								}
							}
						}
						if (!diverged) break;

						const passLabelBoxes = measureRenderedLabelBoxes(svg);
						currentOverrides = computeOverrides(passById, passLabelBoxes, currentOverrides);
						const fresh = cloneLayoutData(origSnapshot);
						applyOverrides(fresh.nodes, currentOverrides);
						data4Layout.nodes = fresh.nodes;
						data4Layout.edges = fresh.edges;
						svg.select('g').selectAll('*').remove();
						await originalRender(data4Layout, svg, helpers, options);
					}
				};
			};

			const wrappedElkLayouts = elkLayouts.map((layoutDef) => ({
				...layoutDef,
				loader: async () => {
					const mod = (await layoutDef.loader()) as { render?: ElkRenderFn; [k: string]: unknown };
					if (typeof mod?.render !== 'function') return mod;
					return {
						...mod,
						render: createUniformSubgraphRender(mod.render),
					};
				},
			}));

			mermaid.registerLayoutLoaders([...wrappedElkLayouts, ...tidyTreeLayouts] as Parameters<
				typeof mermaid.registerLayoutLoaders
			>[0]);

			const readThemeTokens = () => {
				const rootStyle = getComputedStyle(document.documentElement);
				const readToken = (name: string) => rootStyle.getPropertyValue(name).trim();
				const isDark =
					document.documentElement.getAttribute('data-theme') === 'dark' ||
					document.documentElement.classList.contains('dark');
				return { readToken, isDark };
			};

			const configureMermaid = (htmlLabels = true) => {
				const { readToken, isDark } = readThemeTokens();

				const nodeBg = readToken('--mermaid-node-bg') || (isDark ? '#212428' : '#FAF9F5');
				const nodeBorder = readToken('--mermaid-node-border') || (isDark ? '#E87A48' : '#C84B20');
				const textPrimary = readToken('--text-primary') || (isDark ? '#EFECE6' : '#111111');
				const lineColor = readToken('--mermaid-line') || (isDark ? '#9A968E' : '#262523');
				const clusterBg = readToken('--mermaid-cluster-bg') || (isDark ? '#191B1E' : '#E7E5DD');
				const surfaceBg = readToken('--bg-surface') || clusterBg;

				const darkScale = {
					cScale0: '#F97316',
					cScale1: '#3B82F6',
					cScale2: '#34D399',
					cScale3: '#8B5CF6',
					cScale4: '#F59E0B',
					cScale5: '#38BDF8',
					cScaleLabel0: '#FFFFFF',
					cScaleLabel1: '#FFFFFF',
					cScaleLabel2: '#FFFFFF',
					cScaleLabel3: '#FFFFFF',
					cScaleLabel4: '#FFFFFF',
					cScaleLabel5: '#FFFFFF',
				};

				const lightScale = {
					cScale0: '#FAF9F5',
					cScale1: '#EFF6FF',
					cScale2: '#ECFDF5',
					cScale3: '#F5F3FF',
					cScale4: '#FFFBEB',
					cScale5: '#ECFEFF',
					cScaleLabel0: '#111111',
					cScaleLabel1: '#111111',
					cScaleLabel2: '#111111',
					cScaleLabel3: '#111111',
					cScaleLabel4: '#111111',
					cScaleLabel5: '#111111',
				};

				mermaid.initialize({
					startOnLoad: false,
					htmlLabels,
					flowchart: {
						useMaxWidth: true,
						htmlLabels,
					},
					elk: {
						mergeEdges: false,
						nodePlacementStrategy: 'NETWORK_SIMPLEX',
					},
					theme: 'base',
					themeVariables: {
						fontFamily: readToken('--font-mono') || 'IBM Plex Mono, Space Mono, monospace',
						fontSize: '13px',
						background: surfaceBg,
						primaryColor: nodeBg,
						primaryTextColor: textPrimary,
						primaryBorderColor: nodeBorder,
						lineColor,
						secondaryColor: clusterBg,
						tertiaryColor: surfaceBg,
						textColor: textPrimary,
						edgeLabelBackground: clusterBg,
						actorBkg: nodeBg,
						actorBorder: nodeBorder,
						actorTextColor: textPrimary,
						actorLineColor: lineColor,
						signalColor: lineColor,
						signalTextColor: textPrimary,
						noteBkgColor: nodeBg,
						noteBorderColor: nodeBorder,
						noteTextColor: textPrimary,
						...(isDark ? darkScale : lightScale),
					},
				});
			};

			const ensureMindmapTidyTree = (src: string) => {
				const trimmed = src.trim();
				if (/^mindmap\b/.test(trimmed) || /^(?:%%[^\n]*\n\s*)+mindmap\b/.test(trimmed)) {
					return `---\nconfig:\n  layout: tidy-tree\n---\n${trimmed}`;
				}
				const fmMatch = trimmed.match(/^---\s*\n([\s\S]*?)\n---\s*\n([\s\S]*)$/);
				if (
					fmMatch &&
					/^\s*(?:%%[^\n]*\n\s*)*mindmap\b/.test(fmMatch[2]) &&
					!/\blayout\s*:/.test(fmMatch[1])
				) {
					if (/^config\s*:/m.test(fmMatch[1])) {
						return `---\n${fmMatch[1].replace(/^config\s*:[^\n]*$/m, (m) => `${m}\n  layout: tidy-tree`)}\n---\n${fmMatch[2]}`;
					}
					return `---\n${fmMatch[1]}\nconfig:\n  layout: tidy-tree\n---\n${fmMatch[2]}`;
				}
				return trimmed;
			};

			const SVG_NS = 'http://www.w3.org/2000/svg';
			const COPYRIGHT_WATERMARK_TEXT = `© ${new Date().getFullYear()} Shashi Kumar · kumarshaz.github.io`;

			const triggerDownload = (blob: Blob, filename: string) => {
				const url = URL.createObjectURL(blob);
				const link = document.createElement('a');
				link.href = url;
				link.download = filename;
				document.body.appendChild(link);
				link.click();
				link.remove();
				window.setTimeout(() => URL.revokeObjectURL(url), 1000);
			};

			const getSvgDimensions = (svgEl: SVGSVGElement): { width: number; height: number } => {
				let width = 1200;
				let height = 800;
				const vbAttr = (svgEl.getAttribute('viewBox') || '').trim();
				const vbParts = vbAttr.split(/[\s,]+/).map(Number);
				if (
					vbParts.length === 4 &&
					Number.isFinite(vbParts[2]) &&
					vbParts[2] > 0 &&
					Number.isFinite(vbParts[3]) &&
					vbParts[3] > 0
				) {
					width = Math.ceil(vbParts[2]);
					height = Math.ceil(vbParts[3]);
				} else {
					const rect = svgEl.getBoundingClientRect();
					if (rect.width > 16 && rect.height > 16) {
						width = Math.ceil(rect.width);
						height = Math.ceil(rect.height);
					}
				}
				return { width, height };
			};

			const parseViewBox = (svgEl: SVGSVGElement): [number, number, number, number] => {
				const rawVb = (
					svgEl.getAttribute('data-base-viewbox') ||
					svgEl.getAttribute('viewBox') ||
					''
				).trim();
				const parts = rawVb.split(/[\s,]+/).map(Number);
				if (
					parts.length === 4 &&
					parts.every((n) => Number.isFinite(n)) &&
					parts[2] > 0 &&
					parts[3] > 0
				) {
					return [parts[0], parts[1], parts[2], parts[3]];
				}
				const dims = getSvgDimensions(svgEl);
				return [0, 0, dims.width, dims.height];
			};

			const applyCopyrightWatermarkToSvg = (
				svgEl: SVGSVGElement,
				{ includeBackground = false }: { includeBackground?: boolean } = {},
			) => {
				if (!svgEl.hasAttribute('data-base-viewbox')) {
					const initialVb = (svgEl.getAttribute('viewBox') || '').trim();
					if (initialVb) {
						svgEl.setAttribute('data-base-viewbox', initialVb);
					} else {
						const dims = getSvgDimensions(svgEl);
						svgEl.setAttribute('data-base-viewbox', `0 0 ${dims.width} ${dims.height}`);
					}
				}

				svgEl
					.querySelectorAll('[data-copyright-watermark], [data-export-bg]')
					.forEach((el) => el.remove());

				const [vbX, vbY, vbW, vbH] = parseViewBox(svgEl);
				const { readToken, isDark } = readThemeTokens();
				const surfaceBg = readToken('--bg-surface') || (isDark ? '#191B1E' : '#E7E5DD');
				const textMuted = readToken('--text-muted') || (isDark ? '#9A968E' : '#57544E');
				const borderStrong = readToken('--border-strong') || (isDark ? '#EFECE6' : '#111111');
				const accentPrimary = readToken('--accent-primary') || (isDark ? '#E87A48' : '#C84B20');
				const fontMono =
					readToken('--font-mono') || "'IBM Plex Mono', 'Space Mono', ui-monospace, monospace";

				const fontSize = Number(Math.max(10.5, Math.min(20, vbW * 0.0155)).toFixed(2));
				const padX = Math.max(12, Math.round(fontSize * 1.15));
				const accentBarW = Math.max(22, Math.round(fontSize * 2.2));
				const estTextW = COPYRIGHT_WATERMARK_TEXT.length * fontSize * 0.65;
				const minRequiredW = Math.ceil(estTextW + padX * 2 + fontSize);

				let outX = vbX;
				let outW = vbW;
				if (vbW < minRequiredW) {
					outX = Number((vbX - (minRequiredW - vbW) / 2).toFixed(2));
					outW = minRequiredW;
				}

				const topGap = Math.round(fontSize * 0.55);
				const stripH = Math.round(fontSize * 2.75);
				const outY = vbY;
				const outH = Number((vbH + stripH).toFixed(2));

				svgEl.setAttribute('viewBox', `${outX} ${outY} ${outW} ${outH}`);
				if (svgEl.hasAttribute('height') && !/%$/.test(svgEl.getAttribute('height') || '')) {
					svgEl.setAttribute('height', String(Math.ceil(outH)));
				}

				if (includeBackground) {
					const bgRect = document.createElementNS(SVG_NS, 'rect');
					bgRect.setAttribute('data-export-bg', 'true');
					bgRect.setAttribute('x', String(outX));
					bgRect.setAttribute('y', String(outY));
					bgRect.setAttribute('width', String(outW));
					bgRect.setAttribute('height', String(outH));
					bgRect.setAttribute('fill', surfaceBg);
					bgRect.setAttribute('style', `fill: ${surfaceBg};`);
					svgEl.insertBefore(bgRect, svgEl.firstChild);
				}

				const wmGroup = document.createElementNS(SVG_NS, 'g');
				wmGroup.setAttribute('data-copyright-watermark', 'true');
				wmGroup.setAttribute('class', 'mermaid-watermark');

				const ruleY = Number((vbY + vbH + topGap).toFixed(2));
				const strokeW = Number(Math.max(1, fontSize * 0.085).toFixed(2));

				const ruleLine = document.createElementNS(SVG_NS, 'line');
				ruleLine.setAttribute('x1', String(Number((outX + padX).toFixed(2))));
				ruleLine.setAttribute('y1', String(ruleY));
				ruleLine.setAttribute('x2', String(Number((outX + outW - padX).toFixed(2))));
				ruleLine.setAttribute('y2', String(ruleY));
				ruleLine.setAttribute('stroke', borderStrong);
				ruleLine.setAttribute('stroke-opacity', '0.22');
				ruleLine.setAttribute('stroke-width', String(strokeW));
				ruleLine.setAttribute(
					'style',
					`stroke: ${borderStrong}; stroke-opacity: 0.22; stroke-width: ${strokeW}px;`,
				);
				wmGroup.appendChild(ruleLine);

				const accentTick = document.createElementNS(SVG_NS, 'line');
				accentTick.setAttribute('x1', String(Number((outX + padX).toFixed(2))));
				accentTick.setAttribute('y1', String(ruleY));
				accentTick.setAttribute(
					'x2',
					String(Number(Math.min(outX + outW - padX, outX + padX + accentBarW).toFixed(2))),
				);
				accentTick.setAttribute('y2', String(ruleY));
				accentTick.setAttribute('stroke', accentPrimary);
				accentTick.setAttribute('stroke-width', String(Number((strokeW * 1.8).toFixed(2))));
				accentTick.setAttribute(
					'style',
					`stroke: ${accentPrimary}; stroke-width: ${(strokeW * 1.8).toFixed(2)}px;`,
				);
				wmGroup.appendChild(accentTick);

				const textY = Number((ruleY + (stripH - topGap) * 0.5 + fontSize * 0.34).toFixed(2));
				const textEl = document.createElementNS(SVG_NS, 'text');
				textEl.setAttribute('x', String(Number((outX + outW - padX).toFixed(2))));
				textEl.setAttribute('y', String(textY));
				textEl.setAttribute('text-anchor', 'end');
				textEl.setAttribute('fill', textMuted);
				textEl.setAttribute('fill-opacity', '0.92');
				textEl.setAttribute('font-family', fontMono);
				textEl.setAttribute('font-size', String(fontSize));
				textEl.setAttribute('font-weight', '500');
				textEl.setAttribute('letter-spacing', '0.03em');
				textEl.setAttribute(
					'style',
					`fill: ${textMuted}; fill-opacity: 0.92; font-family: ${fontMono}; font-size: ${fontSize}px; font-weight: 500; letter-spacing: 0.03em;`,
				);
				textEl.textContent = COPYRIGHT_WATERMARK_TEXT;
				wmGroup.appendChild(textEl);

				svgEl.appendChild(wmGroup);
				return { width: Math.ceil(outW), height: Math.ceil(outH), surfaceBg };
			};

			const serializeSvgElement = (svgEl: SVGSVGElement) => {
				const clone = svgEl.cloneNode(true) as SVGSVGElement;
				clone.setAttribute('xmlns', SVG_NS);
				clone.setAttribute('xmlns:xlink', 'http://www.w3.org/1999/xlink');

				const { width, height, surfaceBg } = applyCopyrightWatermarkToSvg(clone, {
					includeBackground: true,
				});
				clone.removeAttribute('data-base-viewbox');
				clone.setAttribute('width', String(width));
				clone.setAttribute('height', String(height));
				clone.style.maxWidth = 'none';
				clone.style.width = '';
				clone.style.height = '';
				clone.style.backgroundColor = surfaceBg;

				const serializer = new XMLSerializer();
				return { xml: serializer.serializeToString(clone), width, height, surfaceBg };
			};

			const downloadSvgFromContainer = (containerEl: Element, filenameBase: string): boolean => {
				const svgEl = containerEl.querySelector<SVGSVGElement>('svg');
				if (!svgEl) return false;
				const { xml } = serializeSvgElement(svgEl);
				const safeName = filenameBase.endsWith('.svg') ? filenameBase : `${filenameBase}.svg`;
				triggerDownload(new Blob([xml], { type: 'image/svg+xml;charset=utf-8' }), safeName);
				return true;
			};

			const exportSvgToPng = async (
				containerEl: Element,
				filenameBase: string,
				diagramSource: string,
				scale = 2,
			): Promise<boolean> => {
				const liveSvg = containerEl.querySelector<SVGSVGElement>('svg');
				if (!liveSvg) return false;

				let targetSvg: SVGSVGElement = liveSvg;
				let tempHost: HTMLDivElement | null = null;

				if (liveSvg.querySelector('foreignObject') && diagramSource) {
					try {
						configureMermaid(false);
						const renderId = `mermaid-png-export-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
						const { svg: cleanMarkup } = await mermaid.render(
							renderId,
							ensureMindmapTidyTree(diagramSource),
						);
						tempHost = document.createElement('div');
						tempHost.style.position = 'fixed';
						tempHost.style.left = '-99999px';
						tempHost.style.top = '0';
						tempHost.innerHTML = cleanMarkup;
						document.body.appendChild(tempHost);
						const cleanSvg = tempHost.querySelector<SVGSVGElement>('svg');
						if (cleanSvg) targetSvg = cleanSvg;
					} catch (err) {
						console.warn('Re-render without htmlLabels failed during PNG export:', err);
					} finally {
						configureMermaid(true);
					}
				}

				try {
					const { xml, width, height, surfaceBg } = serializeSvgElement(targetSvg);
					const safeName = filenameBase.endsWith('.png') ? filenameBase : `${filenameBase}.png`;
					const dataUrl = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(xml)}`;

					const img = new window.Image();
					await new Promise<void>((resolve, reject) => {
						img.onload = () => resolve();
						img.onerror = (ev) => reject(ev);
						img.src = dataUrl;
					});

					const effectiveScale = Math.min(
						scale,
						8192 / Math.max(1, width),
						8192 / Math.max(1, height),
					);
					const canvas = document.createElement('canvas');
					canvas.width = Math.max(1, Math.round(width * effectiveScale));
					canvas.height = Math.max(1, Math.round(height * effectiveScale));

					const ctx = canvas.getContext('2d');
					if (!ctx) return false;

					ctx.fillStyle = surfaceBg;
					ctx.fillRect(0, 0, canvas.width, canvas.height);
					ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

					const pngBlob = await new Promise<Blob | null>((resolve) => {
						try {
							canvas.toBlob((blob) => resolve(blob), 'image/png');
						} catch {
							resolve(null);
						}
					});

					if (pngBlob) {
						triggerDownload(pngBlob, safeName);
						return true;
					}

					try {
						const pngUrl = canvas.toDataURL('image/png');
						const res = await fetch(pngUrl);
						triggerDownload(await res.blob(), safeName);
						return true;
					} catch {
						return downloadSvgFromContainer(containerEl, filenameBase);
					}
				} catch (err) {
					console.warn('PNG rasterization failed, falling back to SVG:', err);
					return downloadSvgFromContainer(containerEl, filenameBase);
				} finally {
					if (tempHost) tempHost.remove();
				}
			};

			// Wrap Astro Shiki mermaid code blocks in the Blueprint Figure Wrapper (.mermaid-blueprint)
			const codeBlocks = document.querySelectorAll(
				'pre[data-language="mermaid"], pre code.language-mermaid',
			);

			if (codeBlocks.length > 0) {
				const pageSlug =
					window.location.pathname
						.replace(/^\/|\/$/g, '')
						.split('/')
						.filter(Boolean)
						.pop() || 'diagram';

				const backdrop = document.createElement('div');
				backdrop.className = 'mermaid-lightbox-backdrop';
				backdrop.hidden = true;
				backdrop.setAttribute('aria-hidden', 'true');
				document.body.appendChild(backdrop);

				interface BlueprintController {
					figure: HTMLElement;
					collapse: () => void;
					syncSize: () => void;
				}

				const controllers: BlueprintController[] = [];
				let activeExpanded: BlueprintController | null = null;

				const collapseAll = () => {
					if (activeExpanded) {
						activeExpanded.collapse();
					}
				};

				backdrop.addEventListener('click', collapseAll);
				document.addEventListener('keydown', (e: KeyboardEvent) => {
					if (e.key === 'Escape' && activeExpanded) {
						e.preventDefault();
						collapseAll();
					}
				});

				codeBlocks.forEach((block, index) => {
					const targetElement =
						block.tagName.toLowerCase() === 'code' ? block.parentElement : block;
					if (!targetElement) return;
					const rawSource = (block.textContent || '').trim();
					const filenameBase = `${pageSlug}-diagram-${index + 1}`;

					const figure = document.createElement('figure');
					figure.className = 'mermaid-blueprint';
					figure.setAttribute('data-blueprint-fig', String(index + 1));

					const bar = document.createElement('div');
					bar.className = 'mermaid-blueprint-bar';

					const caption = document.createElement('span');
					caption.className = 'mermaid-blueprint-title';
					caption.textContent = `Architecture Diagram ${index + 1}`;

					const toolbar = document.createElement('div');
					toolbar.className = 'mermaid-toolbar';
					toolbar.setAttribute('role', 'toolbar');
					toolbar.setAttribute('aria-label', 'Diagram zoom and export controls');

					const makeToolbarBtn = (
						text: string,
						title: string,
						extraClass?: string,
					): HTMLButtonElement => {
						const btn = document.createElement('button');
						btn.type = 'button';
						btn.className = extraClass
							? `mermaid-toolbar-btn ${extraClass}`
							: 'mermaid-toolbar-btn';
						btn.textContent = text;
						btn.title = title;
						btn.setAttribute('aria-label', title);
						return btn;
					};

					const makeSep = () => {
						const sep = document.createElement('span');
						sep.className = 'mermaid-toolbar-sep';
						sep.setAttribute('aria-hidden', 'true');
						return sep;
					};

					const zoomOutBtn = makeToolbarBtn('−', 'Zoom out diagram');
					zoomOutBtn.setAttribute('data-zoom-action', 'out');

					const zoomLabel = document.createElement('span');
					zoomLabel.className = 'mermaid-zoom-label';
					zoomLabel.setAttribute('data-zoom-label', 'true');
					zoomLabel.setAttribute('aria-live', 'polite');
					zoomLabel.textContent = '100%';

					const zoomInBtn = makeToolbarBtn('+', 'Zoom in diagram');
					zoomInBtn.setAttribute('data-zoom-action', 'in');

					const resetBtn = makeToolbarBtn('Reset', 'Reset zoom to 100%');
					resetBtn.setAttribute('data-zoom-action', 'reset');

					const svgBtn = makeToolbarBtn('SVG', 'Download SVG diagram');
					svgBtn.setAttribute('data-export-format', 'svg');

					const pngBtn = makeToolbarBtn('PNG', 'Download high-resolution PNG diagram');
					pngBtn.setAttribute('data-export-format', 'png');

					const expandBtn = makeToolbarBtn(
						'Expand',
						'Open diagram in fullscreen lightbox',
						'mermaid-blueprint-zoom',
					);
					expandBtn.setAttribute('data-expand-toggle', 'true');
					expandBtn.setAttribute('aria-expanded', 'false');

					toolbar.append(
						zoomOutBtn,
						zoomLabel,
						zoomInBtn,
						resetBtn,
						makeSep(),
						svgBtn,
						pngBtn,
						makeSep(),
						expandBtn,
					);

					bar.appendChild(caption);
					bar.appendChild(toolbar);

					const viewport = document.createElement('div');
					viewport.className = 'mermaid-viewport';
					viewport.setAttribute('data-zoom-container', 'true');

					const zoomStage = document.createElement('div');
					zoomStage.className = 'mermaid-zoom-stage';
					zoomStage.setAttribute('data-zoom-target', 'true');

					const container = document.createElement('div');
					container.className = 'mermaid';
					container.setAttribute('data-mermaid-src', rawSource);

					zoomStage.appendChild(container);
					viewport.appendChild(zoomStage);
					figure.appendChild(bar);
					figure.appendChild(viewport);
					targetElement.replaceWith(figure);

					let zoomScale = 1;
					let refBaseWidth: number | null = null;

					const applySvgZoom = () => {
						zoomLabel.textContent = `${Math.round(zoomScale * 100)}%`;
						const svgEl = container.querySelector<SVGSVGElement>('svg');
						if (!svgEl) return;

						const { width: vbW, height: vbH } = getSvgDimensions(svgEl);
						const isExpanded = figure.classList.contains('is-expanded');

						if (zoomScale === 1) {
							refBaseWidth = null;
							if (isExpanded) {
								const vw = Math.max(240, viewport.clientWidth - 24);
								const vh = Math.max(200, viewport.clientHeight - 24);
								const fitByHeightW = vbH > 0 ? (vh * vbW) / vbH : vw;
								const expandedW = Math.min(
									vw,
									Math.max(Math.min(vbW, vw), Math.min(vbW * 1.45, vw, fitByHeightW)),
								);
								svgEl.style.maxWidth = 'none';
								svgEl.style.width = `${Math.round(expandedW)}px`;
								svgEl.style.height = 'auto';
							} else {
								svgEl.style.width = '100%';
								svgEl.style.maxWidth = vbW ? `min(100%, ${vbW}px)` : '100%';
								svgEl.style.height = 'auto';
							}
							return;
						}

						if (!refBaseWidth) {
							const rect = svgEl.getBoundingClientRect();
							refBaseWidth = rect.width > 24 ? rect.width : vbW;
						}

						svgEl.style.maxWidth = 'none';
						svgEl.style.width = `${Math.max(160, Math.round(refBaseWidth * zoomScale))}px`;
						svgEl.style.height = 'auto';
					};

					zoomOutBtn.addEventListener('click', () => {
						if (zoomScale === 1) {
							const svgEl = container.querySelector<SVGSVGElement>('svg');
							if (svgEl) refBaseWidth = svgEl.getBoundingClientRect().width || getSvgDimensions(svgEl).width;
						}
						zoomScale = Math.max(0.5, Number((zoomScale - 0.2).toFixed(2)));
						applySvgZoom();
					});

					zoomInBtn.addEventListener('click', () => {
						if (zoomScale === 1) {
							const svgEl = container.querySelector<SVGSVGElement>('svg');
							if (svgEl) refBaseWidth = svgEl.getBoundingClientRect().width || getSvgDimensions(svgEl).width;
						}
						zoomScale = Math.min(2.6, Number((zoomScale + 0.2).toFixed(2)));
						applySvgZoom();
					});

					resetBtn.addEventListener('click', () => {
						zoomScale = 1;
						refBaseWidth = null;
						applySvgZoom();
					});

					svgBtn.addEventListener('click', () => {
						downloadSvgFromContainer(container, filenameBase);
					});

					pngBtn.addEventListener('click', async () => {
						pngBtn.disabled = true;
						try {
							await exportSvgToPng(container, filenameBase, rawSource, 2);
						} finally {
							pngBtn.disabled = false;
						}
					});

					const controller: BlueprintController = {
						figure,
						syncSize: () => {
							refBaseWidth = null;
							applySvgZoom();
						},
						collapse: () => {
							if (!figure.classList.contains('is-expanded')) return;
							figure.classList.remove('is-expanded');
							expandBtn.textContent = 'Expand';
							expandBtn.setAttribute('aria-expanded', 'false');
							expandBtn.title = 'Open diagram in fullscreen lightbox';
							expandBtn.setAttribute('aria-label', 'Open diagram in fullscreen lightbox');
							backdrop.hidden = true;
							document.body.style.overflow = '';
							if (activeExpanded === controller) activeExpanded = null;
							zoomScale = 1;
							refBaseWidth = null;
							applySvgZoom();
							expandBtn.focus();
						},
					};

					expandBtn.addEventListener('click', () => {
						if (figure.classList.contains('is-expanded')) {
							controller.collapse();
							return;
						}
						if (activeExpanded && activeExpanded !== controller) {
							activeExpanded.collapse();
						}
						figure.classList.add('is-expanded');
						expandBtn.textContent = 'Collapse';
						expandBtn.setAttribute('aria-expanded', 'true');
						expandBtn.title = 'Exit fullscreen lightbox (Esc)';
						expandBtn.setAttribute('aria-label', 'Exit fullscreen lightbox');
						backdrop.hidden = false;
						document.body.style.overflow = 'hidden';
						activeExpanded = controller;
						zoomScale = 1;
						refBaseWidth = null;
						window.requestAnimationFrame(() => applySvgZoom());
					});

					controllers.push(controller);
				});

				let renderEpoch = 0;

				const renderDiagrams = async () => {
					configureMermaid(true);
					renderEpoch += 1;
					const nodes = document.querySelectorAll<HTMLElement>('.mermaid');
					for (let i = 0; i < nodes.length; i++) {
						const node = nodes[i];
						const rawSrc = node.getAttribute('data-mermaid-src');
						if (!rawSrc) continue;
						const diagramId = `mermaid-fig-${renderEpoch}-${i + 1}`;
						try {
							const { svg, bindFunctions } = await mermaid.render(
								diagramId,
								ensureMindmapTidyTree(rawSrc),
							);
							node.innerHTML = svg;
							bindFunctions?.(node);
							const renderedSvg = node.querySelector<SVGSVGElement>('svg');
							if (renderedSvg) {
								applyCopyrightWatermarkToSvg(renderedSvg, { includeBackground: false });
							}
							node.removeAttribute('data-mermaid-error');
							controllers[i]?.syncSize();
						} catch (err) {
							const msg =
								err instanceof Error
									? err.message
									: typeof err === 'object' && err !== null && 'message' in err
										? String((err as { message: unknown }).message)
										: JSON.stringify(err);
							console.error(`Mermaid rendering failed on ${diagramId}:`, msg, err);
							node.setAttribute('data-mermaid-error', msg || String(err));
						}
					}
				};

				renderDiagrams();

				// Re-synchronize Mermaid SVG tokens dynamically when the user toggles Light/Dark mode
				window.addEventListener('theme-change', () => {
					renderDiagrams();
				});
			} else {
				configureMermaid(true);
			}
		</script>
	</body>
</html>
