---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type BlogData = CollectionEntry<'blog'>['data'];

interface Props extends Partial<BlogData> {
	title: string;
	description: string;
	pubDate: Date;
	headings?: MarkdownHeading[];
	slug?: string;
	category?: string;
	status?: string;
	repoUrl?: string;
	backHref?: string;
	backLabel?: string;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category = 'Essay',
	tags = [],
	readingTime,
	headings = [],
	repoUrl,
	backHref = '/blog',
	backLabel = '← All Articles',
} = Astro.props;

const tocHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			.spec-article {
				width: 100%;
			}

			/* Article Header Masthead (Option D: Bold 2px Bottom Rule) */
			.article-masthead {
				padding: 2.75rem 0 2rem 0;
				border-bottom: 2px solid var(--border-strong);
			}

			.article-meta-bar {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-bottom: 1rem;
				font-family: var(--font-mono);
				font-size: 0.76rem;
				color: var(--text-muted);
			}

			.spec-title {
				font-family: var(--font-display);
				font-size: clamp(1.95rem, 3.5vw, 2.85rem);
				font-weight: 700;
				line-height: 1.15;
				letter-spacing: -0.025em;
				color: var(--text-primary);
				margin: 0 0 1rem 0;
				max-width: 28ch;
			}

			.spec-abstract {
				font-family: var(--font-sans);
				font-size: 1.08rem;
				line-height: 1.62;
				color: var(--text-muted);
				margin: 0;
				max-width: 68ch;
			}

			.spec-hero-figure {
				margin: 0 0 2.25rem 0;
				border: 1px solid var(--border-grid);
				background-color: var(--bg-surface);
				padding: 0.45rem;
			}

			.spec-hero-figure img {
				display: block;
				width: 100%;
				height: auto;
				border: 1px solid var(--border-grid);
				margin: 0;
				padding: 0;
			}

			.last-updated-on {
				margin-top: 0.35rem;
				font-size: 0.74rem;
				color: var(--text-muted);
			}

			.back-to-index {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--text-muted);
				text-decoration: none;
				padding-top: 1.25rem;
				border-top: 1px solid var(--border-grid);
				margin-top: 1.5rem;
			}

			.back-to-index:hover {
				color: var(--accent-primary);
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main-content">
			<article
				class="spec-article"
				data-category={category}
				data-mermaid-engine="v12-elk-tidytree"
				data-mermaid-tokens="--mermaid-node-bg --mermaid-node-border"
			>
				<!-- Top Article Masthead -->
				<header class="notebook-container">
					<div class="article-masthead">
						<div class="article-meta-bar">
							<span class="mono-badge">[{category}]</span>
							<span>
								<FormattedDate date={pubDate} />
							</span>
							{readingTime && <span>· {readingTime}</span>}
						</div>
						<h1 class="spec-title">{title}</h1>
						<p class="spec-abstract">{description}</p>
					</div>
				</header>

				<!-- Open 2-Column Reading Workspace -->
				<div class="architect-grid">
					<aside class="architect-rail" aria-label="Article Metadata and Table of Contents">
						<div class="rail-sticky">
							<div class="rail-block">
								<span class="rail-label">Published</span>
								<span class="rail-value">
									<FormattedDate date={pubDate} />
								</span>
								{
									updatedDate && (
										<div class="last-updated-on">
											Updated <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>

							<div class="rail-block">
								<span class="rail-label">Category</span>
								<span class="rail-value">{category}</span>
							</div>

							{
								repoUrl && (
									<div class="rail-block">
										<span class="rail-label">Repository</span>
										<a
											href={repoUrl}
											target="_blank"
											rel="noopener noreferrer"
											class="rail-tag"
											style="display: inline-block; margin-top: 0.2rem;"
										>
											View Source on GitHub →
										</a>
									</div>
								)
							}

							<div class="rail-block" id="rail-toc-block">
								<span class="rail-label">ON THIS PAGE</span>
								<ul class="rail-toc-list" id="rail-toc-list">
									{
										tocHeadings.map((heading) => (
											<li class={`toc-depth-${heading.depth}`}>
												<a href={`#${heading.slug}`}>{heading.text}</a>
											</li>
										))
									}
								</ul>
							</div>

							{
								tags && tags.length > 0 && (
									<div class="rail-block">
										<span class="rail-label">TAGS</span>
										<ul class="rail-tags">
											{tags.map((tag) => (
												<li>
													<a href={`/blog/tag/${tag.toLowerCase()}/`} class="rail-tag">
														#{tag}
													</a>
												</li>
											))}
										</ul>
									</div>
								)
							}

							<a href={backHref} class="back-to-index">{backLabel}</a>
						</div>
					</aside>

					<div class="architect-main prose" id="article-prose">
						{
							heroImage && (
								<figure class="spec-hero-figure">
									<Image width={1200} src={heroImage} alt={title} />
								</figure>
							)
						}
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />

		<script is:inline>
			// Populate ON THIS PAGE Table of Contents for pages without pre-extracted Markdown headings (e.g., /about)
			document.addEventListener('DOMContentLoaded', () => {
				const tocList = document.getElementById('rail-toc-list');
				const prose = document.getElementById('article-prose');
				if (tocList && prose && tocList.children.length === 0) {
					const headings = prose.querySelectorAll('h1, h2, h3');
					headings.forEach((h, idx) => {
						if (!h.id) {
							h.id =
								h.textContent
									.toLowerCase()
									.replace(/[^a-z0-9]+/g, '-')
									.replace(/(^-|-$)/g, '') || `section-${idx + 1}`;
						}
						const li = document.createElement('li');
						li.className = `toc-depth-${h.tagName === 'H3' ? '3' : '2'}`;
						const a = document.createElement('a');
						a.href = `#${h.id}`;
						a.textContent = h.textContent;
						li.appendChild(a);
						tocList.appendChild(li);
					});
				}
			});
		</script>

		<script>
			import mermaid from 'mermaid';
			import elkLayouts from '@mermaid-js/layout-elk';
			import tidyTreeLayouts from '@mermaid-js/layout-tidy-tree';

			mermaid.registerLayoutLoaders([...elkLayouts, ...tidyTreeLayouts]);

			const configureMermaid = () => {
				const rootStyle = getComputedStyle(document.documentElement);
				const readToken = (name: string) => rootStyle.getPropertyValue(name).trim();
				const isDark =
					document.documentElement.getAttribute('data-theme') === 'dark' ||
					document.documentElement.classList.contains('dark');

				const nodeBg = readToken('--mermaid-node-bg') || (isDark ? '#212428' : '#FAF9F5');
				const nodeBorder = readToken('--mermaid-node-border') || (isDark ? '#E87A48' : '#C84B20');
				const textPrimary = readToken('--text-primary') || (isDark ? '#EFECE6' : '#111111');
				const lineColor = readToken('--mermaid-line') || (isDark ? '#9A968E' : '#262523');
				const clusterBg = readToken('--mermaid-cluster-bg') || (isDark ? '#191B1E' : '#E7E5DD');
				const surfaceBg = readToken('--bg-surface') || clusterBg;

				const darkScale = {
					cScale0: '#F97316',
					cScale1: '#3B82F6',
					cScale2: '#34D399',
					cScale3: '#8B5CF6',
					cScale4: '#F59E0B',
					cScale5: '#38BDF8',
					cScaleLabel0: '#FFFFFF',
					cScaleLabel1: '#FFFFFF',
					cScaleLabel2: '#FFFFFF',
					cScaleLabel3: '#FFFFFF',
					cScaleLabel4: '#FFFFFF',
					cScaleLabel5: '#FFFFFF',
				};

				const lightScale = {
					cScale0: '#FAF9F5',
					cScale1: '#EFF6FF',
					cScale2: '#ECFDF5',
					cScale3: '#F5F3FF',
					cScale4: '#FFFBEB',
					cScale5: '#ECFEFF',
					cScaleLabel0: '#111111',
					cScaleLabel1: '#111111',
					cScaleLabel2: '#111111',
					cScaleLabel3: '#111111',
					cScaleLabel4: '#111111',
					cScaleLabel5: '#111111',
				};

				mermaid.initialize({
					startOnLoad: false,
					elk: {
						mergeEdges: false,
						nodePlacementStrategy: 'NETWORK_SIMPLEX',
					},
					theme: 'base',
					themeVariables: {
						fontFamily: readToken('--font-mono') || 'IBM Plex Mono, Space Mono, monospace',
						fontSize: '13px',
						background: surfaceBg,
						primaryColor: nodeBg,
						primaryTextColor: textPrimary,
						primaryBorderColor: nodeBorder,
						lineColor,
						secondaryColor: clusterBg,
						tertiaryColor: surfaceBg,
						textColor: textPrimary,
						edgeLabelBackground: clusterBg,
						actorBkg: nodeBg,
						actorBorder: nodeBorder,
						actorTextColor: textPrimary,
						actorLineColor: lineColor,
						signalColor: lineColor,
						signalTextColor: textPrimary,
						noteBkgColor: nodeBg,
						noteBorderColor: nodeBorder,
						noteTextColor: textPrimary,
						...(isDark ? darkScale : lightScale),
					},
				});
			};

			// Wrap Astro Shiki mermaid code blocks in the Blueprint Figure Wrapper (.mermaid-blueprint)
			const codeBlocks = document.querySelectorAll(
				'pre[data-language="mermaid"], pre code.language-mermaid',
			);

			if (codeBlocks.length > 0) {
				codeBlocks.forEach((block, index) => {
					const targetElement =
						block.tagName.toLowerCase() === 'code' ? block.parentElement : block;
					if (!targetElement) return;
					const rawSource = (block.textContent || '').trim();

					const figure = document.createElement('figure');
					figure.className = 'mermaid-blueprint';
					figure.setAttribute('data-blueprint-fig', String(index + 1));

					const bar = document.createElement('div');
					bar.className = 'mermaid-blueprint-bar';

					const caption = document.createElement('span');
					caption.textContent = 'Architecture Diagram';

					const zoomBtn = document.createElement('button');
					zoomBtn.type = 'button';
					zoomBtn.className = 'mermaid-blueprint-zoom';
					zoomBtn.textContent = 'Expand';
					zoomBtn.addEventListener('click', () => {
						const expanded = figure.classList.toggle('is-expanded');
						zoomBtn.textContent = expanded ? 'Collapse' : 'Expand';
					});

					bar.appendChild(caption);
					bar.appendChild(zoomBtn);

					const container = document.createElement('div');
					container.className = 'mermaid';
					container.setAttribute('data-mermaid-src', rawSource);
					container.style.display = 'flex';
					container.style.justifyContent = 'center';

					figure.appendChild(bar);
					figure.appendChild(container);
					targetElement.replaceWith(figure);
				});

				let renderEpoch = 0;

				const ensureMindmapTidyTree = (src: string) => {
					const trimmed = src.trim();
					if (/^mindmap\b/.test(trimmed) || /^(?:%%[^\n]*\n\s*)+mindmap\b/.test(trimmed)) {
						return `---\nconfig:\n  layout: tidy-tree\n---\n${trimmed}`;
					}
					const fmMatch = trimmed.match(/^---\s*\n([\s\S]*?)\n---\s*\n([\s\S]*)$/);
					if (
						fmMatch &&
						/^\s*(?:%%[^\n]*\n\s*)*mindmap\b/.test(fmMatch[2]) &&
						!/\blayout\s*:/.test(fmMatch[1])
					) {
						if (/^config\s*:/m.test(fmMatch[1])) {
							return `---\n${fmMatch[1].replace(/^config\s*:[^\n]*$/m, (m) => `${m}\n  layout: tidy-tree`)}\n---\n${fmMatch[2]}`;
						}
						return `---\n${fmMatch[1]}\nconfig:\n  layout: tidy-tree\n---\n${fmMatch[2]}`;
					}
					return trimmed;
				};

				const renderDiagrams = async () => {
					configureMermaid();
					renderEpoch += 1;
					const nodes = document.querySelectorAll<HTMLElement>('.mermaid');
					for (let i = 0; i < nodes.length; i++) {
						const node = nodes[i];
						const rawSrc = node.getAttribute('data-mermaid-src');
						if (!rawSrc) continue;
						const diagramId = `mermaid-fig-${renderEpoch}-${i + 1}`;
						try {
							const { svg, bindFunctions } = await mermaid.render(
								diagramId,
								ensureMindmapTidyTree(rawSrc),
							);
							node.innerHTML = svg;
							bindFunctions?.(node);
							node.removeAttribute('data-mermaid-error');
						} catch (err) {
							const msg =
								err instanceof Error
									? err.message
									: typeof err === 'object' && err !== null && 'message' in err
										? String((err as { message: unknown }).message)
										: JSON.stringify(err);
							console.error(`Mermaid rendering failed on ${diagramId}:`, msg, err);
							node.setAttribute('data-mermaid-error', msg || String(err));
						}
					}
				};

				renderDiagrams();

				// Re-synchronize Mermaid SVG tokens dynamically when the user toggles Light/Dark mode
				window.addEventListener('theme-change', () => {
					renderDiagrams();
				});
			} else {
				configureMermaid();
			}
		</script>
	</body>
</html>
