---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const pillarTags = ['Architecture', 'SDLC', 'AI', 'Research'];
	const postTags = posts.flatMap((post) => post.data.tags ?? []);
	const tagMap = new Map<string, string>();
	for (const t of [...pillarTags, ...postTags]) {
		const lower = t.toLowerCase();
		if (!tagMap.has(lower)) {
			tagMap.set(lower, t);
		}
	}

	const allTags = [...tagMap.values()];

	return allTags.map((tag) => ({
		params: { tag: tag.toLowerCase() },
		props: {
			tag,
			allTags,
			posts: posts
				.filter((post) =>
					post.data.tags?.map((t: string) => t.toLowerCase()).includes(tag.toLowerCase()),
				)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag, allTags = [], posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`#${tag} — ${SITE_TITLE}`}
			description={`Blog posts tagged with "${tag}"`}
		/>
		<style>
			.tag-masthead {
				padding: 2.5rem 0 1.75rem 0;
				border-bottom: 2px solid var(--border-strong);
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1rem;
			}

			.tag-masthead h1 {
				font-family: var(--font-display);
				font-size: clamp(1.85rem, 3.2vw, 2.5rem);
				font-weight: 700;
				margin: 0 0 0.35rem 0;
			}

			.tag-masthead p {
				font-family: var(--font-sans);
				color: var(--text-muted);
				margin: 0;
			}

			.back-link {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				text-decoration: none;
				color: var(--accent-primary);
			}

			.back-link:hover {
				text-decoration: underline;
			}

			.tag-entries-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.tag-entry-row {
				border-bottom: 1px solid var(--border-grid);
				padding: 1.85rem 0;
			}

			.tag-entry-row:first-child {
				padding-top: 0;
			}

			.tag-entry-row:last-child {
				border-bottom: none;
			}

			.tag-entry-layout {
				display: grid;
				grid-template-columns: 1fr 200px;
				gap: 2rem;
				align-items: start;
			}

			.tag-entry-link {
				text-decoration: none;
				color: inherit;
				display: block;
			}

			.tag-entry-meta {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.65rem;
				margin-bottom: 0.6rem;
				font-family: var(--font-mono);
				font-size: 0.74rem;
				color: var(--text-muted);
			}

			.title {
				font-family: var(--font-display);
				font-size: 1.35rem;
				font-weight: 700;
				margin: 0 0 0.5rem 0;
				color: var(--text-primary);
				line-height: 1.25;
				transition: color 0.15s ease;
			}

			.tag-entry-link:hover .title {
				color: var(--accent-primary);
			}

			.tag-entry-desc {
				font-family: var(--font-sans);
				font-size: 0.94rem;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.6;
			}

			.tag-entry-figure {
				margin: 0;
				padding: 0.35rem;
				border: 1px solid var(--border-grid);
				background-color: var(--bg-surface);
			}

			.tag-entry-figure img {
				display: block;
				width: 100%;
				height: 115px;
				object-fit: cover;
				border: 1px solid var(--border-grid);
			}

			.empty-state {
				padding: 2rem 0;
				font-family: var(--font-sans);
				color: var(--text-muted);
			}

			@media (max-width: 900px) {
				.tag-entry-layout {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<!-- Tag Masthead -->
			<section class="notebook-container">
				<div class="tag-masthead tag-header">
					<div>
						<h1>#{tag}</h1>
						<p>
							{posts.length} post{posts.length !== 1 ? 's' : ''} tagged with "{tag}"
						</p>
					</div>
					<a href="/blog" class="back-link">← All posts</a>
				</div>
			</section>

			<!-- Sidebar Topics + Filtered Entries -->
			<section class="architect-grid">
				<aside class="architect-rail" aria-label="All Topics">
					<div class="rail-sticky">
						<div class="rail-block">
							<span class="rail-label">All Topics</span>
							<ul class="rail-tags">
								{
									allTags.map((t: string) => (
										<li>
											<a
												href={`/blog/tag/${t.toLowerCase()}/`}
												class:list={[
													'rail-tag',
													{ 'is-active': t.toLowerCase() === tag.toLowerCase() },
												]}
											>
												#{t}
											</a>
										</li>
									))
								}
							</ul>
						</div>
					</div>
				</aside>

				<div class="architect-main--wide">
					{
						posts.length > 0 ? (
							<ul class="tag-entries-list">
								{posts.map((post) => {
									const category = post.data.category || 'Essay';
									return (
										<li class="tag-entry-row">
											<div class="tag-entry-layout">
												<div>
													<a href={`/blog/${post.id}/`} class="tag-entry-link">
														<div class="tag-entry-meta">
															<span class="mono-badge">[{category}]</span>
															<span class="date">
																<FormattedDate date={post.data.pubDate} />
															</span>
														</div>
														<h4 class="title">{post.data.title}</h4>
														<p class="tag-entry-desc">{post.data.description}</p>
													</a>
												</div>
												{post.data.heroImage && (
													<a
														href={`/blog/${post.id}/`}
														class="tag-entry-figure"
														aria-hidden="true"
														tabindex="-1"
													>
														<Image
															width={480}
															height={270}
															src={post.data.heroImage}
															alt={post.data.title}
														/>
													</a>
												)}
											</div>
										</li>
									);
								})}
							</ul>
						) : (
							<div class="empty-state">
								<p>No posts with this tag yet. Check back soon!</p>
							</div>
						)
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
