---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import profilePic from '../assets/profile-picture.jpg';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<!-- Hero Banner (Open Notebook Masthead) -->
			<section class="notebook-container">
				<div class="hero">
					<div class="hero-layout">
						<div class="hero-content">
							<p class="hero-eyebrow">
								Product Architect · IEEE Senior Member · Published Researcher
							</p>
							<h1>
								From Blacksmiths<br /><span class="accent">to Goldsmiths.</span>
							</h1>
							<p class="hero-subtitle">
								I help engineering teams transition from effort-based labor to high-precision,
								composable architecture — designed for enterprise scale and built with craftsman's
								care.
							</p>
							<div class="hero-cta">
								<a href="/blog" class="btn-primary">Read the Blog</a>
								<a href="/about" class="btn-secondary">About Me</a>
							</div>
						</div>
						<div class="hero-photo">
							<Image
								src={profilePic}
								alt="Shashi Kumar"
								width={200}
								height={200}
								class="profile-img"
							/>
						</div>
					</div>
				</div>
			</section>

			<!-- Option D Asymmetric Notebook Split: Left Sidebar (Domains & Connect) + Right Stream (Recent Writing) -->
			<section class="architect-grid home-notebook">
				<aside class="architect-rail" aria-label="What I Write About and Connect">
					<!-- Pillars Section -->
					<div class="pillars">
						<h2 class="sidebar-heading">What I Write About</h2>
						<div class="pillars-stack">
							<a href="/blog/tag/architecture" class="pillar-item">
								<h3>Software Architecture →</h3>
								<p>
									Hexagonal, DDD, CQRS, and the "Lego Framework" — composable enterprise systems
									built on company-proven patterns.
								</p>
							</a>
							<a href="/blog/tag/sdlc" class="pillar-item">
								<h3>Enterprise SDLC →</h3>
								<p>
									CI/CD pipelines, API Design-First, and Spec-Driven Development across
									heterogeneous stacks.
								</p>
							</a>
							<a href="/blog/tag/ai" class="pillar-item">
								<h3>AI-Augmented Engineering →</h3>
								<p>
									AI as the "Great Teacher" — automating the structural 90% while empowering humans
									for the final 10% of refinement.
								</p>
							</a>
							<a href="/blog/tag/research" class="pillar-item">
								<h3>Published Research →</h3>
								<p>
									Peer-reviewed papers on Domain Autonomy in Microservices, Composable Enterprise,
									and IoT Data Processing.
								</p>
							</a>
						</div>
					</div>

					<!-- Connect Section -->
					<div class="connect">
						<h2 class="sidebar-heading">Let's Connect</h2>
						<p class="connect-note">
							Open to discussing architecture, enterprise patterns, and agentic AI engineering.
						</p>
						<div class="connect-links">
							<a
								href="https://www.linkedin.com/in/shashinkumar/"
								target="_blank"
								rel="noopener noreferrer"
								class="btn-connect"
							>
								<span>Connect on LinkedIn →</span>
							</a>
							<a
								href="https://github.com/kumarshaz"
								target="_blank"
								rel="noopener noreferrer"
								class="btn-connect"
							>
								<span>View GitHub →</span>
							</a>
							<a
								href="https://dzone.com/users/5309856/snkumar.html"
								target="_blank"
								rel="noopener noreferrer"
								class="btn-connect"
							>
								<span>DZone Publications →</span>
							</a>
						</div>
					</div>
				</aside>

				<!-- Right Main Stream: Latest Writing -->
				<div class="architect-main--wide recent-posts">
					<div class="stream-header">
						<h2 class="stream-title">Latest from the Blog</h2>
						<a href="/blog" class="view-all-link">View all posts →</a>
					</div>

					<ul class="posts-list">
						{
							recentPosts.map((post) => {
								const category = post.data.category || 'Essay';
								return (
									<li class="post-row" data-category={category}>
										<div class="post-row-inner">
											<div class="post-row-body">
												<div class="post-meta">
													<span class="mono-badge">[{category}]</span>
													<span class="post-date">
														<FormattedDate date={post.data.pubDate} />
													</span>
													{post.data.readingTime && (
														<span class="post-reading">· {post.data.readingTime}</span>
													)}
												</div>
												<a href={`/blog/${post.id}/`} class="post-title-link">
													<h3>{post.data.title}</h3>
												</a>
												<p class="post-desc">{post.data.description}</p>
												{post.data.tags && post.data.tags.length > 0 && (
													<div class="post-tags-row">
														{post.data.tags.map((tag) => (
															<a href={`/blog/tag/${tag.toLowerCase()}/`} class="rail-tag">
																#{tag}
															</a>
														))}
													</div>
												)}
											</div>
											{post.data.heroImage && (
												<a
													href={`/blog/${post.id}/`}
													class="post-thumb"
													aria-hidden="true"
													tabindex="-1"
												>
													<Image
														width={360}
														height={200}
														src={post.data.heroImage}
														alt={post.data.title}
													/>
												</a>
											)}
										</div>
									</li>
								);
							})
						}
					</ul>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* ===== Hero Masthead ===== */
	.hero {
		padding: 3rem 0 2.75rem 0;
		border-bottom: 1px solid var(--border-grid);
	}

	.hero-layout {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 3rem;
	}

	.hero-content {
		flex: 1;
	}

	.hero-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-primary);
		margin: 0 0 0.75rem 0;
		font-weight: 600;
	}

	.hero h1 {
		font-family: var(--font-display);
		font-size: clamp(2.1rem, 4vw, 3.1rem);
		line-height: 1.12;
		letter-spacing: -0.03em;
		margin: 0 0 1rem 0;
		color: var(--text-primary);
		font-weight: 700;
	}

	.hero h1 .accent {
		color: var(--accent-primary);
	}

	.hero-subtitle {
		font-family: var(--font-sans);
		font-size: 1.05rem;
		color: var(--text-muted);
		max-width: 60ch;
		margin: 0 0 1.75rem 0;
		line-height: 1.65;
	}

	.hero-cta {
		display: flex;
		gap: 0.85rem;
		flex-wrap: wrap;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		background-color: var(--text-primary);
		color: var(--bg-canvas) !important;
		padding: 0.65rem 1.35rem;
		border: 1px solid var(--text-primary);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.btn-primary:hover {
		background-color: var(--accent-primary);
		border-color: var(--accent-primary);
		color: #ffffff !important;
	}

	.btn-secondary {
		display: inline-flex;
		align-items: center;
		background-color: transparent;
		border: 1px solid var(--border-strong);
		color: var(--text-primary) !important;
		padding: 0.65rem 1.35rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.btn-secondary:hover {
		border-color: var(--accent-primary);
		color: var(--accent-primary) !important;
	}

	.hero-photo {
		flex-shrink: 0;
		padding: 0.4rem;
		background-color: var(--bg-surface);
		border: 1px solid var(--border-grid);
	}

	.hero-photo .profile-img {
		display: block;
		width: 164px;
		height: 164px;
		object-fit: cover;
		border: 1px solid var(--border-grid);
	}

	/* ===== Left Sidebar (Domains & Connect) ===== */
	.home-notebook {
		grid-template-columns: 300px 1fr;
	}

	.sidebar-heading {
		font-family: var(--font-display);
		font-size: 0.88rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-primary);
		margin: 0 0 1rem 0;
		padding-bottom: 0.45rem;
		border-bottom: 2px solid var(--border-strong);
	}

	.pillars {
		margin-bottom: 2.5rem;
	}

	.pillars-stack {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.pillar-item {
		display: block;
		text-decoration: none;
		color: inherit;
		padding-bottom: 1.1rem;
		border-bottom: 1px solid var(--border-grid);
	}

	.pillar-item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.pillar-item h3 {
		font-family: var(--font-mono);
		font-size: 0.86rem;
		font-weight: 700;
		margin: 0 0 0.35rem 0;
		color: var(--text-primary);
		transition: color 0.15s ease;
	}

	.pillar-item:hover h3 {
		color: var(--accent-primary);
	}

	.pillar-item p {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--text-muted);
		margin: 0;
	}

	.connect-note {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--text-muted);
		margin: 0 0 0.85rem 0;
	}

	.connect-links {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.btn-connect {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.45rem 0.7rem;
		border: 1px solid var(--border-grid);
		background-color: var(--bg-surface);
		color: var(--text-primary);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-decoration: none;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.btn-connect:hover {
		border-color: var(--accent-primary);
		color: var(--accent-primary);
	}

	/* ===== Right Stream: Latest from the Blog ===== */
	.stream-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		padding-bottom: 0.45rem;
		margin-bottom: 0.5rem;
		border-bottom: 2px solid var(--border-strong);
	}

	.stream-title {
		font-family: var(--font-display);
		font-size: 0.88rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-primary);
		margin: 0;
		padding: 0;
		border: none;
	}

	.view-all-link {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: var(--accent-primary);
		text-decoration: none;
	}

	.view-all-link:hover {
		text-decoration: underline;
	}

	.posts-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.post-row {
		padding: 1.65rem 0;
		border-bottom: 1px solid var(--border-grid);
	}

	.post-row:last-child {
		border-bottom: none;
	}

	.post-row-inner {
		display: grid;
		grid-template-columns: 1fr 180px;
		gap: 1.75rem;
		align-items: start;
	}

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--text-muted);
	}

	.post-title-link {
		text-decoration: none;
		color: inherit;
	}

	.post-row h3 {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.28;
		margin: 0 0 0.5rem 0;
		color: var(--text-primary);
		transition: color 0.15s ease;
	}

	.post-title-link:hover h3 {
		color: var(--accent-primary);
	}

	.post-desc {
		font-family: var(--font-sans);
		font-size: 0.94rem;
		color: var(--text-muted);
		margin: 0;
		line-height: 1.6;
	}

	.post-tags-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.75rem;
	}

	.post-thumb {
		display: block;
		padding: 0.3rem;
		background-color: var(--bg-surface);
		border: 1px solid var(--border-grid);
	}

	.post-thumb img {
		display: block;
		width: 100%;
		height: 105px;
		object-fit: cover;
		border: 1px solid var(--border-grid);
	}

	/* ===== Responsive ===== */
	@media (max-width: 900px) {
		.home-notebook {
			grid-template-columns: 1fr;
		}
		.hero-layout {
			flex-direction: column-reverse;
			align-items: flex-start;
			gap: 1.5rem;
		}
		.post-row-inner {
			grid-template-columns: 1fr;
		}
		.post-thumb img {
			height: 160px;
		}
	}
</style>
