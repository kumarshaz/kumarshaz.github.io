---
const today = new Date();
---

<footer role="contentinfo" class="site-footer">
	<div class="footer-grid">
		<div class="footer-rail">
			<span class="rail-label">COLOPHON // REV {today.getFullYear()}</span>
			<span class="footer-copy">&copy; {today.getFullYear()} Shashi Kumar. All rights reserved.</span>
		</div>
		<div class="footer-main">
			<div class="footer-credentials">
				<span class="credentials-badge">IEEE Senior Member</span>
				<span class="separator">·</span>
				<span class="credentials-badge">Hackathon Raptors Fellow</span>
				<span class="separator">·</span>
				<span class="credentials-badge">SEFM SAS Society</span>
			</div>
			<div class="social-links">
				<a href="https://www.linkedin.com/in/shashinkumar/" target="_blank" rel="noopener noreferrer" title="LinkedIn">
					<span class="sr-only">Connect with Shashi on LinkedIn</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
						<path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
					</svg>
					<span class="social-text">LINKEDIN</span>
				</a>
				<a href="https://github.com/kumarshaz" target="_blank" rel="noopener noreferrer" title="GitHub">
					<span class="sr-only">Go to Shashi's GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
						<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
					</svg>
					<span class="social-text">GITHUB</span>
				</a>
				<a href="https://dzone.com/users/5309856/snkumar.html" target="_blank" rel="noopener noreferrer" title="DZone Publications">
					<span class="sr-only">View Shashi's DZone Publications</span>
					<svg viewBox="0 0 32 32" aria-hidden="true" width="16" height="16">
						<rect width="32" height="32" rx="2" fill="currentColor" opacity="0.18"/>
						<text x="16" y="22" text-anchor="middle" font-family="monospace" font-weight="bold" font-size="15" fill="currentColor">DZ</text>
					</svg>
					<span class="social-text">DZONE</span>
				</a>
				<a href="/rss.xml" title="RSS Feed">
					<span class="sr-only">Subscribe via RSS</span>
					<span class="social-text">RSS</span>
				</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border-grid);
		background-color: var(--bg-surface);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 240px 1fr;
		max-width: 1200px;
		margin: 0 auto;
		border-left: 1px solid var(--border-grid);
		border-right: 1px solid var(--border-grid);
	}

	.footer-rail {
		padding: 1.75rem 1.5rem;
		border-right: 1px solid var(--border-grid);
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.35rem;
	}

	.footer-copy {
		color: var(--text-primary);
		font-size: 0.74rem;
	}

	.footer-main {
		padding: 1.75rem 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.footer-credentials {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		color: var(--text-muted);
	}

	.separator {
		color: var(--border-strong);
	}

	.social-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.65rem;
		border: 1px solid var(--border-grid);
		background-color: var(--bg-canvas);
		color: var(--text-primary);
		text-decoration: none;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.social-links a:hover {
		color: var(--accent-primary);
		border-color: var(--accent-primary);
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
		.footer-rail {
			border-right: none;
			border-bottom: 1px solid var(--border-grid);
			padding: 1.25rem;
		}
		.footer-main {
			padding: 1.25rem;
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
